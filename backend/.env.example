# Copy this file to .env and fill in the values. Never commit .env (it is ignored by Git).

# Database (required). Neon or any PostgreSQL. This is only the shape of the address:
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Key that signs login tokens (required). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Office time zone, used for check-in times, reports and payroll months
TIMEZONE=Asia/Karachi

# AI assistant (optional). Any OpenAI-compatible provider that supports tool calling.
# Leave AI_API_KEY empty to switch the AI features off. The rest of the app keeps working.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=
AI_TIMEOUT_SECONDS=15
AI_RATE_LIMIT_PER_HOUR=20